{
  "name": "text-to-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "pnpm --filter text-to-design-ui watch",
    "dev:ui": "pnpm --filter text-to-design-ui dev",
    "build": "pnpm --filter text-to-design-ui build && pnpm --filter text-to-design-mcp build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "release": "pnpm build && pnpm exec changeset publish",
    "mcp": "pnpm --filter text-to-design-mcp start:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.13.3",
    "concurrently": "10.0.4",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
