{
  "name": "jsdesign-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"vite build --config vite.config.code.ts --watch\"",
    "build": "vite build && vite build --config vite.config.code.ts && node scripts/package-dist.mjs",
    "watch": "concurrently \"vite build --watch\" \"vite build --config vite.config.code.ts --watch\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jsdesign/shared": "workspace:*",
    "daisyui": "^4.12.24",
    "solid-js": "^1.9.14",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@jsdesigndeveloper/plugin-typings": "^1.0.12",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "10.0.4",
    "postcss": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-solid": "^2.11.13"
  }
}
